<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
          Single-target net8.0 (deliberate deviation from the core library's netstandard2.0;net8.0):
          this is an internal shared orchestration layer consumed only by the net10.0 desktop app
          (FEATURE-001) and the coming CLI (FEATURE-002). It is never packed to NuGet, so it can rely
          on modern C# (records / init / required) without PolySharp. If Tools is ever published,
          switch to `netstandard2.0;net8.0` + PolySharp.
        -->
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Authors>Josué Clément</Authors>
        <Copyright>Copyright © 2026 Josué Clément</Copyright>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Enigma.Cryptography" Version="4.3.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
        <PackageReference Include="Ulid" Version="1.4.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Enigma.LicenseManager\Enigma.LicenseManager.csproj" />
    </ItemGroup>

</Project>
