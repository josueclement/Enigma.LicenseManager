<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Enigma.LicenseManager.Desktop.ViewModels"
             xmlns:carbon="using:Carbon.Avalonia.Desktop.Controls"
             xmlns:editors="using:Carbon.Avalonia.Desktop.Controls.Editors"
             xmlns:helpers="using:Enigma.LicenseManager.Desktop.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
             x:Class="Enigma.LicenseManager.Desktop.Views.GenerateKeysPageView"
             x:DataType="vm:GenerateKeysPageViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16" MaxWidth="800" HorizontalAlignment="Stretch">
      <TextBlock Text="Generate Keys"
                 FontSize="24"
                 FontWeight="SemiBold" />
      <TextBlock Text="Generate RSA or ML-DSA key pairs for signing and validating licenses."
                 Opacity="0.7" TextWrapping="Wrap" />

      <!-- Algorithm Configuration -->
      <carbon:SettingsCardExpander Header="Algorithm Configuration"
                                  Description="Select the algorithm and parameters for key generation"
                                  IsExpanded="True">
        <StackPanel Spacing="12">
          <TextBlock Text="Algorithm" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding AlgorithmOptions}"
                    SelectedIndex="{Binding SelectedAlgorithmIndex}"
                    HorizontalAlignment="Stretch" />
          <TextBlock Text="Parameters" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding ParameterOptions}"
                    SelectedIndex="{Binding SelectedParameterIndex}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
      </carbon:SettingsCardExpander>

      <!-- Private Key Protection -->
      <carbon:SettingsCardExpander Header="Private Key Protection"
                                  Description="Optionally encrypt the private key with a password"
                                  IsExpanded="True">
        <StackPanel Spacing="12">
          <editors:TextEditor Title="Password"
                              Text="{Binding Password}"
                              PasswordChar="&#x2022;"
                              PlaceholderText="Enter password (optional)" />
          <editors:TextEditor Title="Confirm Password"
                              Text="{Binding ConfirmPassword}"
                              PasswordChar="&#x2022;"
                              PlaceholderText="Confirm password"
                              HasValidationError="{Binding HasPasswordMismatch}"
                              ValidationErrorMessage="{Binding PasswordMismatchMessage}" />
        </StackPanel>
      </carbon:SettingsCardExpander>

      <!-- Output Files -->
      <carbon:SettingsCardExpander Header="Output Files"
                                  Description="Select where to save the generated keys"
                                  IsExpanded="True">
        <StackPanel Spacing="12">
          <editors:TextEditor Title="Public Key File"
                              Text="{Binding PublicKeyPath}"
                              PlaceholderText="Select public key output path..."
                              helpers:FileDropHelper.IsEnabled="True"
                              HasValidationError="{Binding PublicKeyPathHasError}"
                              ValidationErrorMessage="Required">
            <editors:TextEditor.ActionContent>
              <Button Content="Browse..."
                      Command="{Binding BrowsePublicKeyPathCommand}"
                      Classes="borderless"
                      Padding="4,2" />
            </editors:TextEditor.ActionContent>
          </editors:TextEditor>
          <editors:TextEditor Title="Private Key File"
                              Text="{Binding PrivateKeyPath}"
                              PlaceholderText="Select private key output path..."
                              helpers:FileDropHelper.IsEnabled="True"
                              HasValidationError="{Binding PrivateKeyPathHasError}"
                              ValidationErrorMessage="Required">
            <editors:TextEditor.ActionContent>
              <Button Content="Browse..."
                      Command="{Binding BrowsePrivateKeyPathCommand}"
                      Classes="borderless"
                      Padding="4,2" />
            </editors:TextEditor.ActionContent>
          </editors:TextEditor>
        </StackPanel>
      </carbon:SettingsCardExpander>

      <!-- Generate Button -->
      <Button Content="Generate Keys"
              Command="{Binding GenerateKeysCommand}"
              HorizontalAlignment="Right"
              Classes="accent" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
