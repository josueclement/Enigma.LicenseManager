<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RootNamespace>Enigma.LicenseManager.Cli</RootNamespace>
        <AssemblyName>enigma-license</AssemblyName>
        <Version>1.0.0</Version>
        <Authors>Josué Clément</Authors>
        <Copyright>Copyright © 2026 Josué Clément</Copyright>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
    </ItemGroup>

    <ItemGroup>
        <!-- The CLI delegates 100% of its logic to the shared Tools layer (AddLicenseTools). -->
        <ProjectReference Include="..\Enigma.LicenseManager\Enigma.LicenseManager.csproj" />
        <ProjectReference Include="..\Enigma.LicenseManager.Tools\Enigma.LicenseManager.Tools.csproj" />
    </ItemGroup>

</Project>
